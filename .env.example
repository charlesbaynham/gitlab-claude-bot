# GitLab instance to poll
GITLAB_URL=https://gitlab.com
# Personal access token of the bot account (api scope); the bot acts as this user
GITLAB_TOKEN=CHANGEME
# Claude credential - set exactly one of the two
CLAUDE_CODE_OAUTH_TOKEN=CHANGEME
#ANTHROPIC_API_KEY=CHANGEME
# Comma-separated GitLab usernames whose to-dos and comments are acted on
ALLOWED_USERS=CHANGEME
# Image each job runs in; pin by digest (image@sha256:...) in production
AGENT_IMAGE=ghcr.io/charlesbaynham/gitlab-claude-bot-agent:latest
# Absolute host path for job checkouts; must not be under /tmp
WORK_DIR=/srv/gitlab-claude-bot/work
# Inside the container; see docker-compose.yml
STATE_DIR=/state
# Seconds between polls
POLL_INTERVAL=30
# Seconds before a running job is killed
JOB_TIMEOUT=1800
# Per-job spend cap in USD; empty for no cap
MAX_BUDGET_USD=
# Model passed to claude; empty for Claude Code's default
CLAUDE_MODEL=
# Port the /health endpoint listens on
HEALTH_PORT=8000
# git clone --depth for each job
CLONE_DEPTH=50
# gid of the host's docker group, read by docker-compose.yml (getent group docker)
DOCKER_GID=999
